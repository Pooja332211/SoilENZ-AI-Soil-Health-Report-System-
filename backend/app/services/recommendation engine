# ─── Dose Calculators ─────────────────────────────────────────────────────────

def _N_dose(n_val: float) -> float:
    deficit = max(0, 280 - n_val)
    return round(min(40, deficit * 0.08), 1)

def _P_dose(p_val: float) -> float:
    deficit = max(0, 22 - p_val)
    return round(min(50, deficit * 1.2), 1)

def _K_dose(k_val: float) -> float:
    deficit = max(0, 280 - k_val)
    return round(min(30, deficit * 0.07), 1)

def _Zn_dose(zn_val: float) -> float:
    if zn_val < 0.4:
        return 5.0
    elif zn_val < 0.6:
        return 4.0
    else:
        return 3.0

def _gypsum_dose(ph: float) -> float:
    excess = max(0, ph - 7.5)
    return round(min(200, excess * 60 + 40), 0)

def _gypsum_dose_ec(ec: float) -> float:
    excess = max(0, ec - 1.2)
    return round(min(300, excess * 80 + 100), 0)

def _lime_dose(ph: float) -> float:
    deficit = max(0, 6.0 - ph)
    return round(min(300, deficit * 120), 0)


# ─── Action Plan Builder ──────────────────────────────────────────────────────

def generate_recommendations(soil: dict, crop: Optional[str] = None) -> dict:
    """
    Generate ranked, actionable recommendations from soil values.
    Returns structured action plan.
    """
    applied = []
    for rule in FERTILIZER_RULES:
        try:
            if rule["condition"](soil):
                dose = rule["dose"](soil) if callable(rule["dose"]) else rule["dose"]
                rationale = rule["rationale"](soil) if callable(rule["rationale"]) else rule["rationale"]
                applied.append({
                    "id": rule["id"],
                    "priority": rule["priority"],
                    "category": rule["category"],
                    "action": rule["action"],
                    "dose": dose,
                    "timing": rule["timing"],
                    "rationale": rationale,
                    "benefit": rule["benefit"],
                })
        except Exception:
            continue

    # Sort by priority
    applied.sort(key=lambda x: x["priority"])

    # Group by category
    grouped: dict[str, list] = {}
    for rec in applied:
        cat = rec["category"]
        grouped.setdefault(cat, []).append(rec)

    # Build phased action plan
    phases = _build_phases(applied, crop)

    # Overall summary
    deficiencies = _identify_deficiencies(soil)
    strengths = _identify_strengths(soil)

    return {
        "recommendations": applied,
        "grouped": grouped,
        "phases": phases,
        "deficiencies": deficiencies,
        "strengths": strengths,
        "count": len(applied),
    }


def _build_phases(recs: list, crop: Optional[str]) -> list[dict]:
    phases = [
        {
            "phase": 1,
            "name": "Pre-Sowing (4-6 weeks before)",
            "actions": [r["action"] for r in recs if r["priority"] == 1 and "Pre-sow" in r.get("timing", "")
                        or r["priority"] == 1 and "Soil Amendment" in r.get("category", "")]
        },
        {
            "phase": 2,
            "name": "Sowing / Basal Application",
            "actions": [r["action"] for r in recs if "basal" in r.get("timing", "").lower()
                        or "sowing" in r.get("timing", "").lower()]
        },
        {
            "phase": 3,
            "name": "Top Dressing (30-45 DAS)",
            "actions": [r["action"] for r in recs if "top dressing" in r.get("timing", "").lower()
                        or "split" in r.get("timing", "").lower()]
        },
        {
            "phase": 4,
            "name": "Foliar / Crop Stage Application",
            "actions": [r["action"] for r in recs if "foliar" in r.get("timing", "").lower()]
        },
    ]
    # Remove empty phases
    phases = [p for p in phases if p["actions"]]
    # Deduplicate
    for p in phases:
        p["actions"] = list(dict.fromkeys(p["actions"]))
    return phases


def _identify_deficiencies(soil: dict) -> list[dict]:
    deficiencies = []
    for param, (lo_opt, hi_opt) in OPTIMAL_RANGES.items():
        val = soil.get(param)
        if val is None:
            continue
        score = _score_parameter(param, val)
        if score < 60:
            severity = "Critical" if score < 30 else "Moderate" if score < 50 else "Mild"
            deficiencies.append({
                "nutrient": param,
                "value": val,
                "optimal_range": f"{lo_opt}-{hi_opt}",
                "severity": severity,
                "score": round(score, 1),
            })
    deficiencies.sort(key=lambda x: x["score"])
    return deficiencies


def _identify_strengths(soil: dict) -> list[dict]:
    strengths = []
    for param, (lo_opt, hi_opt) in OPTIMAL_RANGES.items():
        val = soil.get(param)
        if val is None:
            continue
        score = _score_parameter(param, val)
        if score >= 80:
            strengths.append({
                "nutrient": param,
                "value": val,
                "status": "Optimal" if score >= 90 else "Good",
                "score": round(score, 1),
            })
    strengths.sort(key=lambda x: -x["score"])
    return strengths